# Ninja
.ninja*
build.ninja

# Build-related
RocketSim.Dir/
/ForgeTraining/RLGym/RocketSimV3/target/
build/
# Build scripts, not build output.
!/tools/build/
x86/
x64/
Release/
Debug
# Debug (above) ignores MSVC build-output dirs, but also unintentionally matches
# the ForgeGUI Debug-tab source directory. Keep that source tracked.
!ForgeGUI/src/Debug/
!ForgeGUI/src/Debug/**
out/
*.obj
*.lib
*.exe
*.pdb
*.ilk
*.tmp
*.pyd
*.whl

# Raw binary files
*.bin

# Visual Studio (not using anything VS-related)
.vs/
*.vcxproj
*.sln
*.filters
*.user

# Rider
/.idea

# Anything starting with three underscores
___*

# ML model files or checkpoints
*.pt
*.PT
/checkpoints
/models

# Python cache files
*.pyc

# Don't include libtorch if in local dir
libtorch
*.lt

# Include RocketSimVis obj's 
!/ForgeTraining/ForgeDebugger/RocketSimVis/data/*

# Ignore bots other than ExampleBot
Bots/*/
!Bots/ExampleBot
!Bots/ExampleBot/**
!Bots/PublicBots
!Bots/PublicBots/**
!Bots/PublicBots/**/*.pt
/Bots/ExampleBot/ExampleAgent/Models
# DLLs never belong beside an exported RLBot.exe; keep stray build outputs out of the tracked ExampleBot tree.
# Must follow the ExampleBot negation above to take effect there.
Bots/*/*/rlbot/*.dll

# Local model catalogs and checkpoint fingerprint caches
.rocketforge/

# Reward analysis output, written beside the analyzed model
reward_analysis_*.json

# wandb metadata
/wandb

